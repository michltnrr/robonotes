<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Robonotes - Study Hub</title>
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/footer.css">
    <style>
     
        body {
            background-color: #000000;
            color: white;
            font-family: 'Roboto', sans-serif;
        }
       
        .logo {
            font-size: 1.5rem;
            font-weight: 700;
            background: linear-gradient(to right, #2da8d2, #d93b55);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        /* Simple footer */
        footer {
            padding: 20px;
            text-align: center;
            border-top: 1px solid #1a1a1a;
            color: #666;
            font-size: 0.875rem;
            margin-top: 60px;
        }

        /* Main content centered */
        .main-content {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            margin-top: 40px;
            padding-bottom: 60px;
        }

        #greeting {
            font-size: 2.5rem;
            font-weight: 700;
            background: linear-gradient(to right, #2da8d2, #d93b55);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 8px;
        }

        .subtitle {
            color: #888;
            font-size: 1rem;
            font-weight: 400;
            margin-bottom: 24px;
        }

        .input-container {
            width: 100%;
            max-width: 800px;
            display: flex;
            justify-content: center;
            margin-bottom: 24px;
            padding: 0 20px;
        }

        .input-wrapper {
            background: #1a1a1a;
            border: 1px solid #2a2a2a;
            border-radius: 28px;
            padding: 6px;
            width: 100%;
            box-shadow: 0 4px 24px rgba(0,0,0,0.4);
        }

        .input-wrapper:focus-within {
            border-color: #2da8d2;
            box-shadow: 0 4px 32px rgba(45,168,210,0.15);
        }

        /* Course selector at the top of input */
        .course-selector {
            padding: 12px 24px 8px;
            border-bottom: 1px solid #252525;
        }

        .course-select {
            background: #252525;
            border: 1px solid #333;
            color: #e8e8e8;
            padding: 8px 16px;
            border-radius: 12px;
            font-size: 0.875rem;
            cursor: pointer;
            font-family: inherit;
            outline: none;
            transition: all 0.2s ease;
            min-width: 200px;
        }

        .course-select:hover {
            background: #2d2d2d;
            border-color: #444;
        }

        .course-select:focus {
            border-color: #2da8d2;
        }

        .main-input {
            width: 100%;
            background: transparent;
            border: none;
            outline: none;
            color: #e8e8e8;
            font-size: 1.05rem;
            padding: 16px 24px;
            font-family: inherit;
            resize: none;
            min-height: 56px;
            max-height: 200px;
        }

        .main-input::placeholder {
            color: #666;
        }

        .input-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 16px 8px;
            flex-wrap: wrap;
            gap: 8px;
        }

        .mode-selector {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .mode-btn {
            background: #252525;
            border: 1px solid #333;
            color: #888;
            padding: 6px 14px;
            border-radius: 16px;
            font-size: 0.875rem;
            cursor: pointer;
            transition: all 0.2s ease;
            font-weight: 500;
        }

        .mode-btn:hover { background: #2d2d2d; color: #aaa; }
        .mode-btn.active { background: #2da8d2; border-color: #2da8d2; color: #fff; }

        .submit-btn {
            background: #2da8d2;
            border: none;
            color: #fff;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
            font-size: 1.2rem;
        }

        .submit-btn:hover { background: #2190b0; transform: scale(1.05); }
        .submit-btn:active { transform: scale(0.95); }

        @media (max-width: 768px) {
            .mode-selector { 
                width: 100%;
            }
            
            .mode-btn {
                flex: 1;
                min-width: 0;
            }
        }
    </style>
</head>
<body>
   {{>header}}

    <div class="main-content">
        <h1 id="greeting">Welcome to your study hub</h1>
        <p class="subtitle">Generate descriptive visualizations, quizzes, and summaries instantly</p>

        <div class="input-container">
            <div class="input-wrapper">
                <!-- Course selector integrated at top -->
                <div class="course-selector">
                    <select class="course-select" id="courseSelect">
                        <option value="">Select a course...</option>
                        <option value="1">Calculus I</option>
                        <option value="2">Physics 101</option>
                        <option value="3">Introduction to Psychology</option>
                        <option value="4">Data Structures</option>
                        <option value="add-new">+ Add New Course</option>
                    </select>
                </div>

                <textarea 
                    class="main-input" 
                    id="mainInput"
                    placeholder="Visualize the mechanics of hydrostatic force..."
                    rows="1"
                ></textarea>
                <div class="input-footer">
                    <div class="mode-selector">
                        <button class="mode-btn active" data-mode="video">📹 Video Generator</button>
                        <button class="mode-btn" data-mode="quiz">📚 Quiz Generator</button>
                        <button class="mode-btn" data-mode="summary">✍🏼 Summary Generator</button>
                    </div>
                    <button class="submit-btn" id="submitBtn">↑</button>
                </div>
            </div>
        </div>
    </div>

   {{>footer}}
   <script src="../study.js"></script>

